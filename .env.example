# Environment Configuration Example
# Copy this file to .env and update with your values

# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=marketplace.events
RABBITMQ_QUEUE=notification.order.created

# Security
# Secrets have NO defaults. Services refuse to start if they are missing, shorter
# than 32 characters, or a known placeholder. Docker Compose mounts them from
# ./secrets (run: python scripts/generate_secrets.py). When running a service
# outside Docker, set either the value or a path to a file containing it:
#   JWT_SECRET_KEY=<random>        or  JWT_SECRET_KEY_FILE=secrets/jwt_secret_key
#   INTERNAL_SERVICE_TOKEN=<random> or INTERNAL_SERVICE_TOKEN_FILE=secrets/internal_service_token
# Relative *_FILE paths are resolved from the directory containing this .env.
# Generate a value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY_FILE=secrets/jwt_secret_key
INTERNAL_SERVICE_TOKEN_FILE=secrets/internal_service_token
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
# Comma-separated user IDs (from /auth/register) granted the admin role,
# which is required to create/update/delete products.
ADMIN_USER_IDS=

# Service URLs (for API Gateway)
USER_SERVICE_URL=http://localhost:8001
PRODUCT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003
PAYMENT_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Service Discovery (Optional)
SERVICE_DISCOVERY_ENABLED=false
CONSUL_HOST=localhost
CONSUL_PORT=8500
