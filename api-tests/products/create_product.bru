meta {
  name: Create Product
  seq: 7
}

post {
  url: {{baseUrl}}/products/
  body: json
  auth: none
}

body:json {
  "name": "Laptop",
  "description": "High-performance laptop",
  "price": 999.99,
  "stock": 50,
  "sku": "LAPTOP-001"
}

script:post-response {
  bru.setVar("productId", res.body.id)
}
