meta {
  name: Create Order
  seq: 14
}

post {
  url: {{baseUrl}}/orders/
  body: json
  auth: none
}

body:json {
  "user_id": "{{userId}}",
  "product_id": "{{productId}}",
  "quantity": 2,
  "idempotency_key": "order-test-001",
  "card_last_four": "4242"
}

script:post-response {
  bru.setVar("orderId", res.body.id)
}
