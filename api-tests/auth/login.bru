meta {
  name: Login
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

json {
  "email": "testuser@example.com",
  "password": "securepass123"
}

script {
  res: util_variable.set("accessToken", res.body.access_token)
  res: util_variable.set("userId", res.body.user_id)
}
