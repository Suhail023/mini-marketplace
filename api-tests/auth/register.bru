meta {
  name: Register
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

json {
  "email": "testuser@example.com",
  "password": "securepass123",
  "first_name": "Test",
  "last_name": "User"
}

script {
  bru.setVar("accessToken", res.body.access_token)
  bru.setVar("userId", res.body.user_id)
}
